# ---------------------------------------------------------------------------
# Trading Bot environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# NEVER commit real credentials. `.env` is gitignored.
#
# Paper trading only. ALPACA_PAPER=true is required; live trading is disabled.
# ---------------------------------------------------------------------------

# --- Alpaca credentials (REQUIRED - obtain from alpaca.markets) ---
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_API_SECRET=your_paper_api_secret_here
ALPACA_PAPER=true
ALPACA_DATA_FEED=iex

# --- Telegram alerts (OPTIONAL - leave blank to disable alerts) ---
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=false
TELEGRAM_TIMEOUT=5
TELEGRAM_RETRY_ATTEMPTS=3

# --- Watchlist ---
WATCHLIST=AAPL,NVDA,TSLA,MSFT,AMZN,META,GOOGL,NFLX,AMD,QQQ

# --- Scheduling ---
SLEEPTIME=1M

# --- Strategy / indicators ---
INDICATOR_TIMEFRAME=5 minutes
INDICATOR_LOOKBACK=200

# --- Market session / time filter (times are America/New_York) ---
TIME_FILTER_ENABLED=true
MARKET_OPEN_TIME=09:30
OPENING_BLACKOUT_MINUTES=30
MARKET_TIMEZONE=America/New_York

# --- Risk controls ---
POSITION_SIZE_PCT=0.03
MAX_POSITION_NOTIONAL=2500
MAX_PORTFOLIO_RISK_PCT=0.01
MAX_SHARES_PER_TRADE=100
MAX_CONCURRENT_POSITIONS=2
STOP_LOSS_MIN_PCT=0.010
STOP_LOSS_MAX_PCT=0.015
STOP_LOSS_PCT=0.012
TAKE_PROFIT_PCT=0.04
MIN_REWARD_RISK_RATIO=1.0
DAILY_LOSS_LIMIT_ENABLED=true
DAILY_LOSS_LIMIT_USD=250
DAILY_LOSS_LIMIT_PCT=0.0025

# --- Caching (seconds / entries) ---
INDICATOR_CACHE_TTL=30
CACHE_MAXSIZE=512

# --- Concurrency ---
ALERT_WORKERS=2

# --- Retry / backoff ---
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
RETRY_BACKOFF_FACTOR=2.0
RETRY_JITTER=true

# --- Persistence file paths (relative to project dir) ---
RISK_STATE_FILE=logs/risk_state.json
TRADE_LEDGER_FILE=logs/trade_ledger.json
DB_PATH=data/trading_bot.sqlite

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=tradingbot.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Default operating mode (enforced by config): paper trading only
# ---------------------------------------------------------------------------
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
