# Alpaca paper trading. Values are intentionally blank; supply your own locally.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# Trading session and scheduler
TRADING_CALENDAR=XNYS
TRADING_TIMEZONE=America/New_York
TRADING_EVALUATION_INTERVAL_SECONDS=60
TRADING_SCHEDULER_POLL_SECONDS=1

# Strategy selection is supplied by the application bootstrap.
STRATEGY_NAME=unconfigured
# Strategy settings are strings parsed and validated by the selected strategy.
# Example: STRATEGY_NAME=trend_momentum
# STRATEGY_PARAM_FAST_PERIOD=10
# STRATEGY_PARAM_SLOW_PERIOD=30
# STRATEGY_PARAM_MOMENTUM_PERIOD=5
# STRATEGY_PARAM_ATR_PERIOD=14
# STRATEGY_PARAM_STOP_ATR_MULTIPLE=2.0
# STRATEGY_PARAM_TARGET_ATR_MULTIPLE=3.0
# STRATEGY_PARAM_MINIMUM_ATR_FRACTION=0.001
# STRATEGY_PARAM_MAXIMUM_ATR_FRACTION=0.05
# STRATEGY_PARAM_MAXIMUM_DATA_AGE_SECONDS=180

# Persistence
DATABASE_URL=sqlite:///data/trading_bot.sqlite

# Logging
LOG_LEVEL=INFO
# LOG_FILE=logs/trading_bot.log

# Market data (Alpaca paper account; IEX feed works without SIP entitlement)
MARKET_DATA_FEED=iex
MARKET_DATA_REQUEST_TIMEOUT_SECONDS=10
MARKET_DATA_STALE_AFTER_SECONDS=60
MARKET_DATA_CACHE_TTL_SECONDS=30
MARKET_DATA_RETRY_ATTEMPTS=3
MARKET_DATA_RETRY_BASE_DELAY_SECONDS=0.5
MARKET_DATA_STREAM_TIMEOUT_SECONDS=30

# Alpaca Trading API reliability controls (paper mode only)
ALPACA_REQUEST_TIMEOUT_SECONDS=10
ALPACA_RETRY_ATTEMPTS=3
ALPACA_RETRY_BASE_DELAY_SECONDS=0.5

# Independent risk limits. Defaults and rationale: risk/README.md
RISK_MAX_RISK_PER_TRADE_FRACTION=0.005
RISK_MAX_POSITION_FRACTION=0.03
RISK_DAILY_LOSS_LIMIT_FRACTION=0.0025
RISK_MAX_DRAWDOWN_FRACTION=0.05
RISK_MAX_OPEN_POSITIONS=2
RISK_MAX_PORTFOLIO_EXPOSURE_FRACTION=0.25
RISK_MAX_ORDER_NOTIONAL_FRACTION=0.03
RISK_MAX_SECTOR_EXPOSURE_FRACTION=0.15
RISK_MINIMUM_AVERAGE_DAILY_DOLLAR_VOLUME=1000000
RISK_MAXIMUM_SPREAD_FRACTION=0.005
RISK_MAXIMUM_DAILY_VOLATILITY_FRACTION=0.08
RISK_MARKET_DATA_MAX_AGE_SECONDS=60
RISK_REGULAR_SESSION_ONLY=true
